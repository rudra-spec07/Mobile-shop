# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL / Neon Database Connection String Placeholder
DATABASE_URL=postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/mobile_adda?sslmode=require

# JWT Authentication Placeholder
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=1d

# Frontend CORS Origin
CLIENT_URL=http://localhost:5173

# Initial Super Admin Seed Credentials (Change for Production)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION_SECURE_PASSWORD

# Optional Email Configuration (Future Modules)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=user@example.com
EMAIL_PASSWORD=YOUR_SMTP_PASSWORD_HERE
