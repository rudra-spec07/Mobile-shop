# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL / Neon Database Connection String
DATABASE_URL=postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/mobile_adda?sslmode=require

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=1d

# Frontend CORS Origin
CLIENT_URL=http://localhost:5173

# Optional Email Configuration (Future Modules)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=user@example.com
EMAIL_PASSWORD=secret
