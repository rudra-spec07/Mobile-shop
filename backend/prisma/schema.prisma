// Prisma Schema for Mobile-Adda Backend
// Module 1 & Module 2: User & Auth Schema
// Module 3: Mobile Catalog Management Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CUSTOMER
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum MobileStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String?   @unique
  mobileNumber        String?   @unique
  password            String
  role                Role      @default(CUSTOMER)
  isActive            Boolean   @default(true)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("users")
}

model SystemHealthLog {
  id        String   @id @default(uuid())
  status    String
  timestamp DateTime @default(now())

  @@map("system_health_logs")
}

model Brand {
  id        String      @id @default(uuid())
  name      String      @unique
  slug      String      @unique
  logoUrl   String?
  status    BrandStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  mobiles   Mobile[]

  @@map("brands")
}

model Mobile {
  id              String       @id @default(uuid())
  brandId         String
  brand           Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name            String
  modelNumber     String?
  slug            String       @unique
  description     String?
  price           Decimal      @db.Decimal(10, 2)
  sellingPrice    Decimal?     @db.Decimal(10, 2)
  ram             String?
  storage         String?
  processor       String?
  display         String?
  frontCamera     String?
  rearCamera      String?
  battery         String?
  operatingSystem String?
  network         String?
  simType         String?
  color           String?
  status          MobileStatus @default(ACTIVE)
  featured        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  images          MobileImage[]

  @@index([brandId])
  @@index([name])
  @@index([status])
  @@index([featured])
  @@index([price])
  @@index([createdAt])
  @@map("mobiles")
}

model MobileImage {
  id        String   @id @default(uuid())
  mobileId  String
  mobile    Mobile   @relation(fields: [mobileId], references: [id], onDelete: Cascade)
  imageUrl  String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([mobileId])
  @@map("mobile_images")
}

// ==========================================
// Module 4: Parts & Inventory Management
// ==========================================

enum PartCategoryStatus {
  ACTIVE
  INACTIVE
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

model PartCategory {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  status      PartCategoryStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  parts       Part[]

  @@map("part_categories")
}

model Part {
  id           String                 @id @default(uuid())
  categoryId   String
  category     PartCategory           @relation(fields: [categoryId], references: [id])
  name         String
  partNumber   String                 @unique
  description  String?
  price        Decimal                @db.Decimal(10, 2)
  quantity     Int                    @default(0)
  minimumStock Int                    @default(0)
  imageUrl     String?
  status       PartCategoryStatus     @default(ACTIVE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  transactions InventoryTransaction[]

  @@index([categoryId])
  @@index([name])
  @@index([partNumber])
  @@index([status])
  @@index([price])
  @@index([createdAt])
  @@map("parts")
}

model InventoryTransaction {
  id               String                   @id @default(uuid())
  partId           String
  part             Part                     @relation(fields: [partId], references: [id], onDelete: Cascade)
  type             InventoryTransactionType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  performedBy      String
  createdAt        DateTime                 @default(now())

  @@index([partId])
  @@index([createdAt])
  @@map("inventory_transactions")
}
